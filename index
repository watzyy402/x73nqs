<script>
(()=>{'use strict';
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const pad=n=>String(n).padStart(2,'0');

// <PURE>
const CODES=['USD','EUR','GBP','JPY','CHF','CAD','AUD','NZD','XAU','XAG','BTC','ETH','SGD','MXN','NOK','SEK','ZAR','TRY','PLN','CNH','HKD'];
const INDICES=['US30','US500','USTEC','NAS100','SPX500','GER40','GER30','DE30','DE40','UK100','FRA40','JP225','HK50','AUS200','USOIL','UKOIL','XTIUSD','XBRUSD','DXY','USDX'];
const MONTHS={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};
const sum=a=>a.reduce((x,y)=>x+y,0);
const avg=a=>a.length?sum(a)/a.length:0;

function toNum(s){
  if(s==null) return null;
  let t=String(s).replace(/[−–—]/g,'-').replace(/\s/g,'').replace(/[$€£]/g,'');
  const body=t.replace(/^[+-]/,'');
  if(/^\d{1,3}(,\d{3})+(\.\d+)?$/.test(body)) t=t.replace(/,/g,''); else t=t.replace(',','.');
  const n=parseFloat(t);
  return Number.isFinite(n)?n:null;
}
function findSymbol(text){
  const up=String(text).toUpperCase();
  for(const s of INDICES){ if(new RegExp('(^|[^A-Z0-9])'+s+'(?![A-Z0-9])').test(up)) return s; }
  const re=/(^|[^A-Z])([A-Z]{3})\s?\/?\s?([A-Z]{3})[A-Z]?(?![A-Z])/g; let m;
  while((m=re.exec(up))){ const a=m[2],b=m[3]; if(a!==b&&CODES.includes(a)&&CODES.includes(b)) return a+b; }
  return '';
}
function findSide(t){ const m=t.match(/\b(buy|sell)\b/i); return m?m[1].toLowerCase():null; }
function findLots(t){
  let m=t.match(/(\d+(?:[.,]\d+)?)\s*lots?\b/i);
  if(!m) m=t.match(/(?:volume|size|lots?|qty|quantity)[^\d\n]{0,10}(\d+(?:[.,]\d+)?)/i);
  if(!m) m=t.match(/\b(?:buy|sell)\b\s*[,:]?\s*(\d+(?:[.,]\d+)?)/i);
  const v=m?toNum(m[1]):null;
  return v>0&&v<1000?v:null;
}
const TG='(?:(?!open|clos|stop|take|profit|swap|comm|volume|time|s\\s*\\/\\s*[lp]|t\\s*\\/\\s*p)[^\\d]){0,26}?';
const NUM='(-?\\d[\\d,]*\\.\\d+|-?\\d[\\d,]*)(?!\\d)(?![.\\-\\/:]\\d)';
function labeled(t,label){ const m=t.match(new RegExp('(?:'+label.source+')'+TG+NUM,'i')); return m?toNum(m[1]):null; }
function findPnl(t){
  const t2=t.replace(/take\s*profit|stop\s*loss|t\s*\/\s*p|s\s*\/\s*l/ig,' X ');
  const lab='(?:profit|p\\s*[\\/&]\\s*l|pnl|\\bnet\\b)';
  const gap='(?:(?!swap|comm|fee)[^\\d+\\-−–$]){0,14}?';
  const m=t2.match(new RegExp(lab+gap+'([+\\-−–])?\\s*\\$?\\s*([+\\-−–])?\\s*(\\d[\\d,]*(?:\\.\\d{1,2})?)','i'));
  const isNeg=x=>/[-−–]/.test(x||'');
  if(m){ const val=toNum(m[3]); if(val!=null) return {val,neg:(isNeg(m[1])||isNeg(m[2]))?true:((m[1]||m[2])?false:null)}; }
  const f=/([+\-−–])\s*\$?\s*(\d[\d,]*\.\d{2})(?!\d)(?!\s*lots?)|\$\s*([+\-−–])\s*(\d[\d,]*\.\d{2})(?!\d)/.exec(t2);
  if(f) return {val:toNum(f[2]||f[4]),neg:isNeg(f[1]||f[3])};
  return null;
}
function findTime(t){
  const c=[]; let m;
  const push=(idx,y,mo,d,h,mi,s,ap)=>{
    h=+h; if(ap){ const pm=/p/i.test(ap); if(pm&&h<12) h+=12; if(!pm&&h===12) h=0; }
    const dt=new Date(+y,mo,+d,h,+mi,+(s||0));
    if(!isNaN(dt)&&dt.getFullYear()===+y&&dt.getMonth()===mo) c.push({idx,ts:dt.getTime()});
  };
  let re=/(\d{4})[.\-\/](\d{1,2})[.\-\/](\d{1,2})[ T,]+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*([AP]M)?/gi;
  while((m=re.exec(t))) push(m.index,m[1],m[2]-1,m[3],m[4],m[5],m[6],m[7]);
  re=/(\d{1,2})[ .\-]([A-Za-z]{3,9})\.?,?\s*(\d{4})?[ ,]*(?:at\s*)?(\d{1,2}):(\d{2})(?::(\d{2}))?\s*([AP]M)?/gi;
  while((m=re.exec(t))){ const mo=MONTHS[m[2].slice(0,3).toLowerCase()]; if(mo!=null) push(m.index,m[3]||new Date().getFullYear(),mo,m[1],m[4],m[5],m[6],m[7]); }
  re=/([A-Za-z]{3,9})\.?\s+(\d{1,2}),?\s*(\d{4})?[ ,]*(?:at\s*)?(\d{1,2}):(\d{2})(?::(\d{2}))?\s*([AP]M)?/gi;
  while((m=re.exec(t))){ const mo=MONTHS[m[1].slice(0,3).toLowerCase()]; if(mo!=null) push(m.index,m[3]||new Date().getFullYear(),mo,m[2],m[4],m[5],m[6],m[7]); }
  re=/(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{4})[ T,]+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*([AP]M)?/gi;
  while((m=re.exec(t))){ let d=+m[1],mo=+m[2]; if(mo>12&&d<=12){const x=d;d=mo;mo=x;} push(m.index,m[3],mo-1,d,m[4],m[5],m[6],m[7]); }
  if(!c.length) return null;
  c.sort((x,y)=>x.idx-y.idx);
  return c[c.length-1].ts;
}
function findTicket(t){ const m=t.match(/(?:#|\border\b|\bticket\b|\bposition\b|\bdeal\b)\s*[:#]?\s*(\d{6,12})\b/i); return m?m[1]:null; }

function parseTrade(raw){
  const t=String(raw||'').replace(/\r/g,'').replace(/[|_]/g,' ').replace(/[ \t]+/g,' ');
  const symbol=findSymbol(t), side=findSide(t), lots=findLots(t);
  const pos=v=>v!=null&&v>0?v:null;
  const open=pos(labeled(t,/open(?!\s*time)(?:\s*price)?|entry(?:\s*price)?/));
  const close=pos(labeled(t,/clos(?:e|ed|ing)(?!d?\s*time)(?:\s*price)?|exit(?:\s*price)?/));
  const sl=pos(labeled(t,/stop\s*loss|s\s*\/\s*l|\bsl\b/));
  const tp=pos(labeled(t,/take\s*profit|t\s*\/\s*p|\btp\b/));
  const pnl=findPnl(t);
  const amount=pnl?Math.abs(pnl.val):null;
  let inferred=null;
  if(open&&close&&side){ const dd=(side==='buy'?1:-1)*(close-open); inferred=dd>0?'win':dd<0?'loss':'be'; }
  let result=null;
  if(pnl&&pnl.neg===true) result='loss'; else if(pnl&&pnl.neg===false) result='win'; else result=inferred;
  if(amount===0) result='be';
  const ts=findTime(t), ticket=findTicket(t), warn=[];
  if(!symbol) warn.push('symbol'); if(!side) warn.push('side'); if(amount==null) warn.push('amount'); if(!result) warn.push('result');
  if(pnl&&inferred&&result!==inferred&&result!=='be') warn.push('mismatch');
  return {symbol,side,lots,open,close,sl,tp,amount,result,ts,ticket,warn};
}
function rMult(t){
  if(!t.sl||!t.open||t.close==null) return null;
  const risk=Math.abs(t.open-t.sl); if(!risk) return null;
  return (t.side==='buy'?1:-1)*(t.close-t.open)/risk;
}
function plannedRR(t){
  if(!t.sl||!t.tp||!t.open) return null;
  const risk=Math.abs(t.open-t.sl); if(!risk) return null;
  return Math.abs(t.tp-t.open)/risk;
}
function calc(list,base){
  const T=[...list].sort((a,b)=>a.ts-b.ts);
  const W=T.filter(t=>t.pnl>0), L=T.filter(t=>t.pnl<0), n=T.length;
  const gw=sum(W.map(t=>t.pnl)), gl=-sum(L.map(t=>t.pnl)), net=gw-gl;
  const avgW=W.length?gw/W.length:0, avgL=L.length?gl/L.length:0;
  let eq=base,peak=base,dd=0,ddp=0,cw=0,cl=0,bw=0,bl=0;
  for(const t of T){
    eq+=t.pnl; if(eq>peak) peak=eq;
    const d=peak-eq; if(d>dd){dd=d;ddp=peak>0?d/peak*100:0;}
    if(t.pnl>0){cw++;cl=0;bw=Math.max(bw,cw);} else if(t.pnl<0){cl++;cw=0;bl=Math.max(bl,cl);} else {cw=0;cl=0;}
  }
  const last=T[n-1], cur=!last?0:last.pnl>0?cw:last.pnl<0?-cl:0;
  const pl=T.map(plannedRR).filter(x=>x!=null), rs=T.map(rMult).filter(x=>x!=null);
  return {n,wins:W.length,losses:L.length,be:n-W.length-L.length,gw,gl,net,avgW,avgL,
    wr:n?W.length/n*100:0,
    pf:gl>0?gw/gl:(gw>0?Infinity:0),
    payoff:avgL>0?avgW/avgL:(avgW>0?Infinity:0),
    exp:n?net/n:0,
    best:W.length?Math.max(...W.map(t=>t.pnl)):null,
    worst:L.length?Math.min(...L.map(t=>t.pnl)):null,
    dd,ddp,bw,bl,cur,
    planned:pl.length?avg(pl):null,plannedN:pl.length,avgR:rs.length?avg(rs):null,rN:rs.length};
}
// </PURE>

