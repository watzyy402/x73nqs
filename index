<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#111214">
<title>Edge · Private Trading Journal</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23111214'/%3E%3Cpath d='M7 21l6-7 4 4 8-9' fill='none' stroke='%2310b76a' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#e5e6e9;--bg2:#f1f2f4;--card:#ffffff;--ink:#15171a;--ink2:#555c67;--ink3:#8b919c;--line:#e1e3e7;
  --green:#0fb36a;--green-bg:rgba(15,179,106,.10);--red:#e0484d;--red-bg:rgba(224,72,77,.09);--amber:#d99a0b;
  --shadow:0 1px 2px rgba(20,22,26,.04),0 12px 32px rgba(20,22,26,.06);
}
[data-theme=dark]{
  --bg:#0d0e10;--bg2:#17191c;--card:#1a1c20;--ink:#f1f2f4;--ink2:#a1a7b1;--ink3:#6b717b;--line:#2a2d33;
  --green:#2fd480;--green-bg:rgba(47,212,128,.13);--red:#ff666b;--red-bg:rgba(255,102,107,.12);
  --shadow:0 1px 2px rgba(0,0,0,.3),0 12px 32px rgba(0,0,0,.35);
}
*{box-sizing:border-box;margin:0}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{font-family:'Hanken Grotesk',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);min-height:100vh;min-height:100dvh;-webkit-font-smoothing:antialiased;overflow-x:hidden;line-height:1.4}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
input,select,textarea{font:inherit;color:inherit}
.ico{display:block;flex:none}
.num{font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.up{color:var(--green)}.dn{color:var(--red)}.muted{color:var(--ink3);font-size:13px}
h3{font-size:17px;font-weight:700;letter-spacing:-.01em}
h4{font-size:14px;font-weight:700;margin:22px 0 10px}

/* ---------- lock screen ---------- */
#lock{position:fixed;inset:0;z-index:100;background:#111214;color:#f3f4f6;overflow:hidden;display:grid;place-items:center;padding:24px;overflow-y:auto;transition:opacity .8s ease,filter .8s ease,transform 1s cubic-bezier(.7,0,.2,1)}
#lock.leaving{opacity:0;filter:blur(12px);transform:scale(1.05);pointer-events:none}
.lk-grid{position:absolute;inset:-2px;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(70% 60% at 50% 45%,#000 15%,transparent 75%);mask-image:radial-gradient(70% 60% at 50% 45%,#000 15%,transparent 75%);opacity:0}
.go .lk-grid{animation:fadeIn 1.8s .1s forwards}
.lk-glow{position:absolute;width:80vmax;height:80vmax;left:50%;top:36%;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(15,179,106,.17),transparent 70%);opacity:0;pointer-events:none}
.go .lk-glow{animation:fadeIn 2.4s .3s forwards,breathe 8s 2.7s ease-in-out infinite}
.lk-line{position:absolute;left:0;right:0;bottom:0;width:100%;height:64%;pointer-events:none}
.lk-line path{fill:none;stroke:#0fb36a;stroke-width:2;vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1;filter:drop-shadow(0 0 8px rgba(15,179,106,.6));opacity:.75}
.go .lk-line path{animation:draw 2.8s .5s cubic-bezier(.55,0,.2,1) forwards}
.lk-candles{position:absolute;inset:0;pointer-events:none;-webkit-mask-image:linear-gradient(to top,transparent 0,#000 22%,#000 72%,transparent 100%);mask-image:linear-gradient(to top,transparent 0,#000 22%,#000 72%,transparent 100%)}
.lk-candles i{position:absolute;left:var(--l);bottom:var(--b);width:var(--w);height:var(--h);color:var(--c);transform-origin:bottom;transform:scaleY(0);opacity:0}
.lk-candles i::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:1px;background:currentColor;opacity:.8}
.lk-candles i b{position:absolute;left:0;right:0;top:var(--t);height:var(--bh);background:currentColor;border-radius:2px}
.go .lk-candles i{animation:candleIn 1s var(--d) cubic-bezier(.2,.9,.2,1) forwards,bob 7s calc(var(--d) + 1.2s) ease-in-out infinite}
.lk-wrap{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center;width:100%;margin:auto}
.lk-mark{position:relative;width:76px;height:76px;border-radius:24px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.04);display:grid;place-items:center;opacity:0;transform:scale(.6)}
.lk-mark svg{overflow:visible}
.lk-mark path{stroke-dasharray:1;stroke-dashoffset:1}
.lk-mark::after{content:'';position:absolute;inset:-1px;border-radius:24px;border:1px solid rgba(15,179,106,.7);opacity:0}
.go .lk-mark{animation:pop .9s .8s cubic-bezier(.2,1.3,.3,1) forwards}
.go .lk-mark path{animation:draw 1.1s 1.2s ease forwards}
.go .lk-mark::after{animation:ring 3.2s 2.4s ease-out infinite}
.lk-title{font-family:'JetBrains Mono',monospace;font-weight:800;font-size:clamp(46px,13vw,76px);letter-spacing:.14em;margin:26px 0 0 .14em;display:flex;perspective:600px}
.lk-title span{display:inline-block;opacity:0;transform:translateY(46px) rotateX(-70deg)}
.go .lk-title span{animation:letter .9s calc(1.1s + var(--k)*90ms) cubic-bezier(.2,.9,.2,1) forwards}
.lk-sub{margin-top:10px;color:#9aa0a9;font-size:15px;opacity:0}
.go .lk-sub{animation:fadeIn 1s 1.9s forwards}
.lk-card{width:min(92vw,380px);margin-top:28px;padding:22px;border-radius:24px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.11);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);opacity:0;transform:translateY(26px);text-align:left}
.go .lk-card{animation:cardUp .9s 2.1s cubic-bezier(.2,.8,.2,1) forwards}
.lk-hello{font-size:15px;color:#c9cdd3;margin-bottom:14px;line-height:1.35}
.lk-hello b{color:#fff;font-weight:700}
.lk-row{position:relative;margin-bottom:10px}
.lk-lab{display:block;font-size:13px;color:#9aa0a9;margin:0 0 6px 2px;font-weight:600}
.lk-in{width:100%;height:50px;border-radius:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff;padding:0 16px;font-size:16px;outline:0;transition:border-color .2s,box-shadow .2s}
.lk-in::placeholder{color:#6f757e}
.lk-in:focus{border-color:rgba(15,179,106,.85);box-shadow:0 0 0 4px rgba(15,179,106,.16)}
.lk-eye{position:absolute;right:6px;bottom:6px;width:38px;height:38px;border-radius:10px;display:grid;place-items:center;color:#8d939c}
.lk-eye:hover{color:#fff}
.lk-btn{width:100%;height:52px;border-radius:14px;background:#f3f4f6;color:#111214;font-weight:800;font-size:15px;margin-top:6px;transition:transform .2s,background .2s}
.lk-btn:hover{background:#fff;transform:translateY(-1px)}
.lk-btn.busy{opacity:.65;pointer-events:none}
.lk-err{min-height:20px;margin-top:10px;font-size:13px;color:#ff7b80;text-align:center}
.lk-foot{margin-top:18px;font-size:13px;color:#6f757e;opacity:0}
.go .lk-foot{animation:fadeIn 1s 2.6s forwards}
.shake{animation:shake .45s!important;opacity:1!important;transform:none!important}
#lock.fast .lk-mark,#lock.fast .lk-card,#lock.fast .lk-title span,#lock.fast .lk-sub,#lock.fast .lk-foot{opacity:1;transform:none;animation:none!important}
#lock.fast .lk-mark path{stroke-dashoffset:0;animation:none!important}
@keyframes fadeIn{to{opacity:1}}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes pop{to{opacity:1;transform:scale(1)}}
@keyframes letter{to{opacity:1;transform:none}}
@keyframes cardUp{to{opacity:1;transform:none}}
@keyframes candleIn{to{transform:scaleY(1);opacity:var(--o)}}
@keyframes bob{0%,100%{translate:0 0}50%{translate:0 -10px}}
@keyframes breathe{0%,100%{opacity:1}50%{opacity:.55}}
@keyframes ring{0%{opacity:.9;transform:scale(1)}100%{opacity:0;transform:scale(1.7)}}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-9px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(3px)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes wipe{from{clip-path:circle(0px at 50% 200px)}to{clip-path:circle(150% at 50% 200px)}}
@keyframes draw2{to{stroke-dashoffset:0}}

/* ---------- app ---------- */
#app.reveal{animation:wipe 1.15s cubic-bezier(.65,0,.25,1) backwards}
.wrap{max-width:1160px;margin:0 auto;padding:max(18px,env(safe-area-inset-top)) 16px 90px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:4px 0 22px}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.logo{width:40px;height:40px;border-radius:13px;background:var(--ink);color:var(--card);display:grid;place-items:center;flex:none}
.hello{min-width:0}
.hello small{display:block;color:var(--ink3);font-size:13px;font-weight:600}
.hello b{display:block;font-size:17px;font-weight:700;letter-spacing:-.015em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.actions{display:flex;gap:8px;align-items:center;flex:none}
.icon-btn{width:42px;height:42px;border-radius:13px;background:var(--card);border:1px solid var(--line);display:grid;place-items:center;color:var(--ink2);transition:color .2s,transform .2s}
.icon-btn:hover{color:var(--ink);transform:translateY(-1px)}
.icon-btn.sm{width:36px;height:36px;border-radius:11px;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:42px;padding:0 17px;border-radius:13px;font-weight:700;font-size:14px;transition:transform .2s,box-shadow .2s,background .2s;white-space:nowrap}
.btn.primary{background:var(--ink);color:var(--card)}
.btn.primary:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(0,0,0,.2)}
.btn.ghost{background:var(--bg2);border:1px solid var(--line)}
.btn.ghost:hover{background:var(--bg)}
.btn.danger{color:var(--red);background:var(--red-bg)}
.btn.wide{width:100%}
.btn.busy{opacity:.6;pointer-events:none}

.hero{display:flex;justify-content:space-between;align-items:flex-end;gap:22px;flex-wrap:wrap;padding:6px 2px 26px}
.hero .lbl{font-size:14px;color:var(--ink2);font-weight:600}
.big{font-size:clamp(38px,9vw,76px);font-weight:800;line-height:1.02;margin:6px 0 12px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:7px;padding:6px 12px;border-radius:99px;font-size:13px;font-weight:700;background:var(--card);border:1px solid var(--line)}
.chip.up{background:var(--green-bg);border-color:transparent}
.chip.dn{background:var(--red-bg);border-color:transparent}
.chip .live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(15,179,106,.55);animation:pulse 2.2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 8px rgba(15,179,106,0)}100%{box-shadow:0 0 0 0 rgba(15,179,106,0)}}
.hero-r{display:flex;flex-direction:column;gap:14px;align-items:flex-end;max-width:100%}
.quick{display:flex;gap:0;border:1px solid var(--line);border-radius:14px;background:var(--card);overflow:hidden}
.quick div{padding:9px 16px;min-width:92px}
.quick div+div{border-left:1px solid var(--line)}
.quick small{display:block;font-size:12px;color:var(--ink3);font-weight:600}
.quick b{font-size:14px}
.seg{display:inline-flex;background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:3px;gap:2px}
.seg button{padding:7px 13px;border-radius:9px;font-size:13px;font-weight:700;color:var(--ink2);transition:background .15s,color .15s}
.seg button.on{background:var(--card);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.14)}
.seg.full{display:flex;width:100%}.seg.full button{flex:1;padding:10px}
.seg button.win.on{color:var(--green)}.seg button.loss.on{color:var(--red)}

.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:20px;box-shadow:var(--shadow);position:relative;min-width:0}
.s12{grid-column:span 12}.s8{grid-column:span 8}.s6{grid-column:span 6}.s4{grid-column:span 4}
.card-h{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.card-h .muted{display:block;margin-top:2px}

.eq{position:relative;height:270px;touch-action:pan-y}
.eq svg{display:block;overflow:visible}
.eq-line{fill:none;stroke:currentColor;stroke-width:2.6;stroke-linejoin:round}
.eq-area{fill:url(#eqg)}
.eq text{font-family:'JetBrains Mono',monospace;font-size:11px;fill:var(--ink3)}
.eq .gl{stroke:var(--line);stroke-width:1}
.eq .bl{stroke:var(--ink3);stroke-width:1;stroke-dasharray:3 5;opacity:.6}
.eq.anim .eq-line{stroke-dasharray:1;stroke-dashoffset:1;animation:draw2 1.9s .35s cubic-bezier(.45,0,.2,1) forwards}
.eq.anim .eq-area{opacity:0;animation:fadeIn 1.2s 1.2s forwards}
.tip{position:absolute;top:0;left:0;pointer-events:none;background:var(--ink);color:var(--card);border-radius:12px;padding:8px 11px;font-size:12px;line-height:1.35;white-space:nowrap;opacity:0;transition:opacity .12s;z-index:3}
.tip b{font-family:'JetBrains Mono',monospace;font-size:13px}
.empty{display:grid;place-items:center;text-align:center;gap:10px;padding:34px 12px;color:var(--ink2)}
.empty b{font-size:16px;color:var(--ink)}
.empty .ill{width:64px;height:64px;border-radius:20px;background:var(--bg2);display:grid;place-items:center;color:var(--ink3)}

.ringbox{position:relative;width:176px;height:176px;margin:4px auto 16px}
.ringbox svg{width:100%;height:100%}
.ringbox .trk{fill:none;stroke:var(--bg);stroke-width:12}
.ringbox .val{fill:none;stroke:var(--green);stroke-width:12;stroke-linecap:round;transition:stroke-dashoffset 1.6s .5s cubic-bezier(.3,.7,.1,1)}
.ring-c{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.ring-c b{font-size:36px;font-weight:800}
.ring-c small{color:var(--ink3);font-size:13px;font-weight:600;margin-top:2px}
.wlbar{display:flex;height:8px;border-radius:99px;overflow:hidden;background:var(--bg);gap:2px}
.wlbar i{display:block;height:100%}
.wlbar .g{background:var(--green)}.wlbar .r{background:var(--red)}.wlbar .n{background:var(--ink3)}
.legend{display:flex;justify-content:space-between;margin-top:10px;font-size:13px;color:var(--ink2);font-weight:600}

.strip{display:grid;grid-template-columns:repeat(4,1fr);padding:0}
.strip>div{padding:20px 22px}
.strip>div+div{border-left:1px solid var(--line)}
.k-l{font-size:14px;color:var(--ink2);font-weight:600}
.k-v{font-size:clamp(24px,3.4vw,34px);font-weight:800;margin:6px 0 4px}
.k-s{font-size:13px;color:var(--ink3)}

.split{display:grid;grid-template-columns:1fr 1fr;padding:0;overflow:hidden}
.half{padding:22px;position:relative}
.half+.half{border-left:1px solid var(--line)}
.half::before{content:'';position:absolute;inset:0 0 auto 0;height:110px;background:linear-gradient(var(--green-bg),transparent);pointer-events:none}
.half.l::before{background:linear-gradient(var(--red-bg),transparent)}
.half>*{position:relative}
.half h3{display:flex;align-items:center;gap:9px}
.half h3 i{width:10px;height:10px;border-radius:50%;background:var(--green)}
.half.l h3 i{background:var(--red)}
.half .cnt{font-size:48px;font-weight:800;margin:10px 0 2px;line-height:1}
.rows{margin-top:16px;border-top:1px solid var(--line)}
.rows div{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--line);font-size:14px}
.rows span{color:var(--ink2)}
.rows b{font-family:'JetBrains Mono',monospace;font-size:13.5px;font-weight:700}

.calnav{display:flex;align-items:center;gap:6px}
.calnav b{min-width:120px;text-align:center;font-size:14px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.cal .dow{font-size:12px;font-weight:600;color:var(--ink3);text-align:center;padding-bottom:2px}
.cal .day{aspect-ratio:1/1;border-radius:10px;background:var(--bg2);padding:5px 6px;font-size:11px;display:flex;flex-direction:column;justify-content:space-between;min-width:0;overflow:hidden}
.cal .day.none{background:transparent}
.cal .day.today{box-shadow:inset 0 0 0 1.5px var(--ink)}
.cal .day em{font-style:normal;color:var(--ink3);font-weight:600}
.cal .day b{font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:700;text-align:right;white-space:nowrap}
.symrow{display:grid;grid-template-columns:90px 1fr auto;gap:12px;align-items:center;padding:9px 0}
.symrow+.symrow{border-top:1px solid var(--line)}
.symrow .nm{font-weight:700;font-size:14px}.symrow .nm small{display:block;font-weight:500;color:var(--ink3);font-size:12px}
.bar{height:8px;background:var(--bg2);border-radius:99px;position:relative;overflow:hidden}
.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px;transition:width 1s cubic-bezier(.3,.7,.1,1)}
.bar i.g{background:var(--green)}.bar i.r{background:var(--red)}
.symrow .v{font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;min-width:84px;text-align:right}

.tl-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.in{height:44px;border-radius:12px;border:1px solid var(--line);background:var(--bg2);padding:0 12px;outline:0;transition:border-color .15s,background .15s;width:100%;font-size:16px}
.in.sm{height:38px;width:170px;font-size:14px}
.in:focus{border-color:var(--ink);background:var(--card)}
.in.warn{border-color:var(--amber);background:rgba(217,154,11,.08)}
select.in{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--ink3) 50%),linear-gradient(135deg,var(--ink3) 50%,transparent 50%);background-position:calc(100% - 18px) 19px,calc(100% - 13px) 19px;background-size:5px 5px;background-repeat:no-repeat;padding-right:32px}
.tl-h,.trow{display:grid;grid-template-columns:1.5fr 1.1fr 1.6fr .8fr 1fr 100px;gap:12px;align-items:center;padding:13px 12px}
.tl-h{font-size:13px;font-weight:600;color:var(--ink3);padding-top:4px;padding-bottom:8px}
.trow{border-top:1px solid var(--line);transition:background .15s}
.trow:hover{background:var(--bg2)}
.trow.fresh{animation:flash 1.8s ease-out}
@keyframes flash{0%{background:var(--green-bg)}100%{background:transparent}}
.c-sym{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.c-sym .s{font-weight:800;font-size:15px}
.pill{font-size:11px;font-weight:800;padding:3px 8px;border-radius:7px;letter-spacing:.02em}
.pill.buy{background:var(--green-bg);color:var(--green)}.pill.sell{background:var(--red-bg);color:var(--red)}
.c-sym .lots{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink3)}
.c-time,.c-px{font-size:13px;color:var(--ink2)}
.c-px{font-family:'JetBrains Mono',monospace;font-size:12.5px}
.c-r{font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700}
.c-pnl{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:800;text-align:right}
.c-act{display:flex;gap:2px;justify-content:flex-end}
.c-act button{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;color:var(--ink3)}
.c-act button:hover{background:var(--bg);color:var(--ink)}
@media(max-width:760px){
  .tl-h{display:none}
  .trow{grid-template-columns:1fr auto;grid-template-areas:"sym pnl" "time px" "r act";row-gap:7px;padding:14px 4px}
  .c-sym{grid-area:sym}.c-pnl{grid-area:pnl}.c-time{grid-area:time}.c-px{grid-area:px;text-align:right}.c-r{grid-area:r}.c-act{grid-area:act}
}

/* ---------- sheets ---------- */
.scrim{position:fixed;inset:0;background:rgba(10,12,14,.55);-webkit-backdrop-filter:blur(7px);backdrop-filter:blur(7px);opacity:0;pointer-events:none;transition:opacity .25s;z-index:60;display:flex;align-items:flex-end;justify-content:center}
.scrim.on{opacity:1;pointer-events:auto}
