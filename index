/* ================= importing screenshots ================= */
function loadScript(src){ return new Promise((res,rej)=>{ if(document.querySelector(`script[src="${src}"]`)&&window.Tesseract) return res(); const s=document.createElement('script'); s.src=src; s.onload=res; s.onerror=()=>rej(new Error('script')); document.head.appendChild(s); }); }
let workerP=null;
function setProg(p,txt){ const b=$('#ocrbar'); if(b) b.style.width=Math.round(p*100)+'%'; if(txt){ const n=$('#ocrnote'); if(n) n.textContent=txt; } }
function getWorker(){
  if(!workerP) workerP=(async()=>{
    await loadScript('https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js');
    const w=await Tesseract.createWorker('eng',1,{logger:m=>{ if(m.status==='recognizing text') setProg(m.progress); else if(m.progress!=null) setProg(m.progress,'Preparing the reader… '+Math.round(m.progress*100)+'%'); }});
    try{ await w.setParameters({tessedit_pageseg_mode:Tesseract.PSM.SINGLE_BLOCK,preserve_interword_spaces:'1'}); }catch{}
    return w;
  })().catch(e=>{ workerP=null; throw e; });
  return workerP;
}
function loadImg(file){ return new Promise((res,rej)=>{ const u=URL.createObjectURL(file),i=new Image(); i.onload=()=>{i._u=u;res(i);}; i.onerror=()=>{URL.revokeObjectURL(u);rej(new Error('img'));}; i.src=u; }); }
function thumb(img){ const w=Math.min(420,img.naturalWidth),h=Math.round(img.naturalHeight*w/img.naturalWidth),c=document.createElement('canvas'); c.width=w; c.height=h; c.getContext('2d').drawImage(img,0,0,w,h); return c.toDataURL('image/jpeg',.6); }
function prep(img){
  let s=Math.min(2,Math.max(1,1800/img.naturalWidth)); if(img.naturalHeight*s>7000) s=7000/img.naturalHeight;
  const c=document.createElement('canvas'); c.width=Math.round(img.naturalWidth*s); c.height=Math.round(img.naturalHeight*s);
  const x=c.getContext('2d',{willReadFrequently:true}); x.drawImage(img,0,0,c.width,c.height);
  const im=x.getImageData(0,0,c.width,c.height),p=im.data; let tot=0;
  for(let i=0;i<p.length;i+=4){ const g=(p[i]*.299+p[i+1]*.587+p[i+2]*.114)|0; p[i]=p[i+1]=p[i+2]=g; tot+=g; }
  if(tot/(p.length/4)<115) for(let i=0;i<p.length;i+=4){ p[i]=p[i+1]=p[i+2]=255-p[i]; }
  x.putImageData(im,0,0); return c;
}
async function readShot(file){
  let img=null,d={warn:[]};
  try{
    img=await loadImg(file);
    const shot=thumb(img);
    try{ const w=await getWorker(); const r=await w.recognize(prep(img)); d=parseTrade(r.data.text); d.raw=r.data.text; }catch(e){ console.warn(e); d={warn:['ocr']}; }
    d.shot=shot;
  }catch(e){ d={warn:['ocr']}; }
  finally{ if(img&&img._u) URL.revokeObjectURL(img._u); }
  if(!d.ts){ d.ts=file.lastModified||Date.now(); d.warn=[...(d.warn||[]),'time']; }
  return d;
}
function openImport(){
  openSheet(`<div class="sh-h"><div><h3>Add trades</h3><p class="muted">Screenshots are read on your device. Nothing gets uploaded.</p></div><button class="icon-btn sm" data-act="closesheet" aria-label="Close">${ico('x',16)}</button></div>
    <label class="drop" id="drop">${ico('upload',30)}<b>Drop screenshots here</b><span>or tap to choose. You can also paste with Ctrl/⌘ + V.</span><input type="file" id="fileIn" accept="image/*" multiple hidden></label>
    <div class="or">or</div><button class="btn ghost wide" id="manualBtn">${ico('edit')}Enter a trade by hand</button>
    <p class="hint">Works with the Exness and Easy Markets apps, MT4, MT5 and Exness Terminal. Show the symbol, buy or sell, prices and profit in the shot. You'll check every trade before it's saved.</p>`);
  $('#fileIn').onchange=e=>{ const f=[...e.target.files]; e.target.value=''; startImport(f); };
  const drop=$('#drop');
  ['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();e.stopPropagation();drop.classList.add('over');}));
  drop.addEventListener('dragleave',()=>drop.classList.remove('over'));
  drop.addEventListener('drop',e=>{ e.preventDefault(); e.stopPropagation(); drop.classList.remove('over'); $('#dropov').classList.remove('on'); dragN=0; startImport(e.dataTransfer.files); });
  $('#manualBtn').onclick=()=>reviewForm({side:null,ts:Date.now(),result:null},{manual:true});
}
async function startImport(fileList){
  const files=[...fileList].filter(f=>f.type.startsWith('image/'));
  if(!files.length){ toast('Pick image files (PNG or JPG).'); return; }
  const flow={cancel:false}; S.flow=flow;
  let chain=Promise.resolve();
  const jobs=files.map(f=>{ const p=chain.then(()=>readShot(f)); chain=p; return p; });
  let saved=0;
  for(let i=0;i<jobs.length;i++){
    if(flow.cancel) break;
    openSheet(`<div class="reading"><div class="spin"></div><b>Reading screenshot ${i+1} of ${files.length}</b><div class="bar"><i id="ocrbar"></i></div><p class="muted" id="ocrnote">The first scan downloads the reader (about 15 MB, once). After that it's quick.</p></div>`);
    const d=await jobs[i];
    if(flow.cancel) break;
    const res=await reviewForm(d,{queue:true,i,total:files.length});
    if(res==='cancel'){ flow.cancel=true; break; }
    if(res==='saved') saved++;
  }
  closeSheet(); S.flow=null;
  if(saved) toast(`${saved} trade${saved>1?'s':''} added. Stats updated.`);
}

