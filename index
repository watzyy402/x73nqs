    const f=e.target.files[0]; if(!f) return;
    try{ const j=JSON.parse(await f.text()); const src=j.data||j; if(!Array.isArray(src.trades)) throw 0;
      const have=new Set(S.data.trades.map(t=>t.id)); let n=0;
      src.trades.forEach(t=>{ if(t&&t.id&&!have.has(t.id)&&Number.isFinite(t.ts)&&Number.isFinite(t.pnl)){ S.data.trades.push(t); n++; } });
      await save(); render(); closeSheet(); toast(n?`${n} trade${n>1?'s':''} restored.`:'Nothing new in that backup.');
    }catch{ toast("That file isn't an Edge backup."); }
  };
  $('#x-wipe').onclick=async()=>{ if(await askConfirm('Erase all trades and the password?','Erase')){ await DB.clear(); location.reload(); } };
}

/* ================= events ================= */
function toggleTheme(){
  const r=document.documentElement, t=r.dataset.theme==='dark'?'light':'dark'; r.dataset.theme=t;
  try{localStorage.setItem('edge-theme',t);}catch{}
  const b=$('#themeBtn'); if(b) b.innerHTML=ico(t==='dark'?'sun':'moon');
}
document.addEventListener('click',e=>{
  const el=e.target.closest('[data-act]'); if(!el||!S.data&&el.dataset.act!=='theme') return;
  const v=el.dataset.v, id=el.dataset.id;
  const A={
    add:openImport, lock:lockApp, settings:openSettings, theme:toggleTheme, closesheet:closeSheet,
    period:()=>{S.period=v;render();},
    filter:()=>{S.filter=v;renderTrades();},
    calprev:()=>{S.cal=new Date(S.cal.getFullYear(),S.cal.getMonth()-1,1);renderCal();},
    calnext:()=>{S.cal=new Date(S.cal.getFullYear(),S.cal.getMonth()+1,1);renderCal();},
    edit:()=>editTrade(id),
    shot:()=>lightbox(S.data.trades.find(t=>t.id===id)?.shot),
    lightbox:()=>lightbox($('img',el)?.src)
  };
  A[el.dataset.act]?.();
});
$('#scrim').addEventListener('click',e=>{ if(e.target.id==='scrim') closeSheet(); });
document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&$('#scrim').classList.contains('on')) closeSheet(); });
$('#lockForm').addEventListener('submit',submitLock);
$('#lockForm').addEventListener('click',e=>{ const b=e.target.closest('[data-eye]'); if(!b) return; const inp=b.parentElement.querySelector('input'); const show=inp.type==='password'; inp.type=show?'text':'password'; b.innerHTML=ico(show?'eyeoff':'eye'); });
['pointerdown','keydown','touchstart','scroll'].forEach(ev=>addEventListener(ev,()=>{ if(S.data) resetIdle(); },{passive:true}));
let dragN=0;
addEventListener('dragenter',e=>{ if(!S.data||!e.dataTransfer||![...e.dataTransfer.types].includes('Files')) return; dragN++; $('#dropov').classList.add('on'); });
addEventListener('dragleave',()=>{ if(!S.data) return; dragN=Math.max(0,dragN-1); if(!dragN) $('#dropov').classList.remove('on'); });
addEventListener('dragover',e=>{ if(S.data) e.preventDefault(); });
addEventListener('drop',e=>{ if(!S.data) return; e.preventDefault(); dragN=0; $('#dropov').classList.remove('on'); if(S.flow&&!S.flow.cancel) return; startImport(e.dataTransfer.files); });
addEventListener('paste',e=>{ if(!S.data||(S.flow&&!S.flow.cancel)) return; const files=[...(e.clipboardData?.files||[])].filter(f=>f.type.startsWith('image/')); if(files.length){ e.preventDefault(); startImport(files); } });
let rz; addEventListener('resize',()=>{ clearTimeout(rz); rz=setTimeout(()=>{ if(S.data) drawEquity(false); },150); });
setInterval(()=>{ if(S.data&&!$('#app').hidden) renderHero(),$$('#hero [data-count]').forEach(countUp); },60000);

/* ================= boot ================= */
async function init(){
  try{ const th=localStorage.getItem('edge-theme'); if(th) document.documentElement.dataset.theme=th; }catch{}
  $$('[data-ico]').forEach(el=>{ el.outerHTML=ico(el.dataset.ico); });
  $('#themeBtn').innerHTML=ico(document.documentElement.dataset.theme==='dark'?'sun':'moon');
  buildCandles(); buildTitle();
  const f=$('#lockForm');
  if(!window.crypto||!crypto.subtle){ f.innerHTML='<div class="lk-hello">This browser blocks encryption on this page. Open the site over https (your GitHub Pages link) or on localhost.</div>'; requestAnimationFrame(()=>$('#lock').classList.add('go')); return; }
  try{ S.meta=await DB.get('meta'); }catch(e){ f.innerHTML='<div class="lk-hello">Storage is blocked in this browser. Turn off private mode and reload.</div>'; requestAnimationFrame(()=>$('#lock').classList.add('go')); return; }
  showLock(S.meta?'unlock':'setup',false);
  const go=()=>requestAnimationFrame(()=>$('#lock').classList.add('go'));
  (document.fonts&&document.fonts.ready?Promise.race([document.fonts.ready,new Promise(r=>setTimeout(r,900))]):Promise.resolve()).then(go);
}
init();
})();
</script>
